---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { postTypeLabel } from '../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  readingTime: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}
const { post, readingTime, headings = [] } = Astro.props;
const { title, description, author, pubDate, updatedDate, category, tags } = post.data;
const typeLabel = postTypeLabel(post.data.type);
const tocHeadings = headings.filter((h) => h.slug && h.text);
---

<BaseLayout title={title} description={description} activeNav={post.data.type === 'knowledge' ? '/knowledge' : '/records'}>
  <article class="post">
    <header class="post-header">
      <div class:list={['post-shell', { 'has-toc': tocHeadings.length > 0 }]}>
        <div class="post-primary">
          <div class="post-labels">
            <div class:list={['type-badge', post.data.type]}>{typeLabel}</div>
            <div class="category">{category}</div>
          </div>
          <h1>{title}</h1>
          <p class="description">{description}</p>
          <div class="meta">
            <FormattedDate date={pubDate} />
            <span class="sep">·</span>
            <span>{readingTime}</span>
            <span class="sep">·</span>
            <span>{author}</span>
            {updatedDate && (
              <>
                <span class="sep">·</span>
                <span>업데이트 <FormattedDate date={updatedDate} /></span>
              </>
            )}
          </div>
        </div>
      </div>
    </header>

    <div class:list={['post-shell', 'post-main', { 'has-toc': tocHeadings.length > 0 }]}>
      <div class="post-primary post-body prose">
        <slot />
      </div>

      {tocHeadings.length > 0 && (
        <aside class="toc" aria-label="목차">
          <div class="toc-inner">
            <p class="toc-title">ON THIS PAGE</p>
            <nav class="toc-nav">
              {tocHeadings.map((h) => (
                <a href={`#${h.slug}`} class:list={['toc-link', `depth-${h.depth}`]}>{h.text}</a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>

    <div id="image-lightbox" class="image-lightbox" hidden role="dialog" aria-modal="true" aria-label="이미지 확대 보기">
      <button type="button" class="lightbox-close" aria-label="닫기">×</button>
      <img class="lightbox-img" alt="" />
    </div>

    {tags.length > 0 && (
      <footer class="post-footer">
        <div class:list={['post-shell', { 'has-toc': tocHeadings.length > 0 }]}>
          <div class="post-primary">
            <div class="tags">
              {tags.map(t => <span class="tag">#{t}</span>)}
            </div>
          </div>
        </div>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .post-header {
    padding: 80px 0 40px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 48px;
  }
  .post-header .post-labels {
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    align-items: center;
    column-gap: 10px;
    margin-bottom: 20px;
    white-space: nowrap;
  }
  .post-header .category {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 0;
    line-height: 1;
  }
  .post-header .type-badge {
    width: fit-content;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 5px 10px;
    margin-bottom: 0;
    text-transform: uppercase;
  }
  .post-header .type-badge.knowledge {
    color: var(--accent-bright);
  }
  .post-header h1 {
    font-size: 38px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.01em;
    margin-bottom: 18px;
    color: var(--accent-bright);
  }
  .description {
    font-size: 17px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 24px;
    font-weight: 300;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    display: flex;
    gap: 10px;
    align-items: center;
    letter-spacing: 0.08em;
  }
  .sep { opacity: 0.5; }

  .post-shell {
    max-width: var(--wrap-narrow);
    margin: 0 auto;
    padding: 0 40px;
    width: 100%;
  }
  .post-shell.has-toc {
    max-width: var(--wrap);
    display: grid;
    grid-template-columns: minmax(0, var(--wrap-narrow)) 230px;
    justify-content: center;
    gap: 44px;
    align-items: start;
  }
  .post-primary {
    min-width: 0;
  }
  .post-main {
    width: 100%;
  }

  .toc {
    min-width: 0;
    position: sticky;
    /* 고정 헤더 바로 아래에 붙는다 */
    top: calc(var(--header-h) + 23px);
    align-self: start;
  }
  .toc-inner {
    max-height: calc(100vh - var(--header-h) - 43px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    border-top: 1px solid var(--border);
    padding-top: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--text-dim) transparent;
  }
  .toc-inner::-webkit-scrollbar { width: 10px; }
  .toc-inner::-webkit-scrollbar-track { background: transparent; }
  .toc-inner::-webkit-scrollbar-thumb {
    background: var(--text-dim);
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  .toc-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--text-dim);
    margin-bottom: 10px;
  }
  .toc-nav {
    display: grid;
  }
  .toc-link {
    font-size: 13px;
    color: var(--text-dim);
    text-decoration: none;
    line-height: 1.45;
    padding: 6px 0 6px 10px;
    border-bottom: 1px solid var(--border);
    border-left: 2px solid transparent;
    transition: color 0.2s, border-left-color 0.2s;
  }
  .toc-link:hover {
    color: var(--accent-bright);
  }
  .toc-link.depth-3 {
    padding-left: 22px;
    font-size: 12px;
  }
  /* 현재 읽고 있는 섹션 — 막대만 포인트 컬러로 짚고 글자는 밝기로 구분한다.
     글자까지 주황이면 목록 전체가 시끄러워지고, 라이트 모드에서 대비가 떨어진다. */
  .toc-link.is-active {
    color: var(--accent-bright);
    border-left-color: var(--brand);
  }

  .post-footer {
    padding: 24px 0;
    margin-top: 36px;
    border-top: 1px solid var(--border);
  }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 2px;
    letter-spacing: 0.05em;
  }

  @media (max-width: 1100px) {
    .post-shell.has-toc {
      max-width: var(--wrap-narrow);
      display: block;
    }
    .toc {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .post-shell {
      padding: 0 20px;
    }
    .post-header { padding: 56px 0 32px; }
    .post-header h1 { font-size: 28px; }
    .post-footer {
      padding: 20px 0;
      margin-top: 28px;
    }
  }

  .post-body :global(img) {
    cursor: zoom-in;
  }
  .image-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    cursor: zoom-out;
  }
  .image-lightbox[hidden] { display: none; }
  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
  }
  .lightbox-close {
    position: fixed;
    top: 20px;
    right: 24px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.16);
  }
</style>

<script>
  const lightbox = document.getElementById('image-lightbox') as HTMLElement | null;
  const lightboxImg = lightbox?.querySelector('.lightbox-img') as HTMLImageElement | null;
  const body = document.querySelector('.post-body');

  function open(src: string, alt: string) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function close() {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.src = '';
    document.body.style.overflow = '';
  }

  body?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'IMG') {
      const img = target as HTMLImageElement;
      if (img.closest('a')) return;
      e.preventDefault();
      open(img.currentSrc || img.src, img.alt);
    }
  });
  // 확대 화면은 어디를 눌러도 닫는다. 커서가 이미 축소 돋보기인데 이미지 위에서만
  // 아무 일도 없으면, 커서가 없는 동작을 가리키는 셈이다.
  lightbox?.addEventListener('click', () => close());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) close();
  });

  // 목차 스크롤 스파이 — 지금 읽고 있는 섹션을 강조한다.
  // IntersectionObserver 대신 "화면 상단 기준선을 지난 마지막 헤딩"으로 판정한다.
  // 섹션이 화면보다 길면 어떤 헤딩도 교차하지 않는 구간이 생겨 강조가 끊기기 때문이다.
  (() => {
    const links = Array.from(document.querySelectorAll('.toc-link')) as HTMLAnchorElement[];
    if (links.length === 0) return;

    const targets = links.map((a) => {
      const id = decodeURIComponent(a.hash.slice(1));
      return document.getElementById(id);
    });
    const tocInner = document.querySelector('.toc-inner') as HTMLElement | null;
    const LINE = 120; // 뷰포트 상단에서 이만큼 내려온 지점을 '읽는 줄'로 본다
    let current = -1;
    let ticking = false;
    let locked = false;

    function activate(index: number) {
      if (index === current) return;
      current = index;
      links.forEach((a, i) => a.classList.toggle('is-active', i === index));

      // 목차가 자체 스크롤을 가질 만큼 길 때, 활성 항목이 보이도록 목차만 스크롤한다
      // (scrollIntoView는 페이지까지 움직여서 쓰지 않는다)
      const active = links[index];
      if (!tocInner || !active) return;
      const box = tocInner.getBoundingClientRect();
      const item = active.getBoundingClientRect();
      if (item.top < box.top) {
        tocInner.scrollTop -= box.top - item.top + 8;
      } else if (item.bottom > box.bottom) {
        tocInner.scrollTop += item.bottom - box.bottom + 8;
      }
    }

    function update() {
      ticking = false;
      // 목차를 눌러 이동하는 동안에는 스파이를 재우고, 누른 항목을 그대로 켜 둔다.
      // 안 그러면 지나가는 섹션들이 차례로 켜졌다가 도착해서야 제자리를 찾는다.
      if (locked) return;
      let index = 0;
      for (let i = 0; i < targets.length; i++) {
        const el = targets[i];
        if (el && el.getBoundingClientRect().top - LINE <= 0) index = i;
        else break;
      }
      // 문서 끝에 닿으면 마지막 섹션을 읽고 있는 것으로 본다
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        index = targets.length - 1;
      }
      activate(index);
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // 목차 클릭 — 표시는 즉시 옮기고 스크롤은 짧게 끝낸다.
    // 브라우저 기본(scroll-behavior: smooth)은 거리가 멀수록 오래 끌어서,
    // 다 내려간 뒤에야 강조가 따라붙는 것처럼 보였다.
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    let animation = 0;

    function glideTo(top: number, done: () => void) {
      cancelAnimationFrame(animation);
      const start = window.scrollY;
      const limit = document.documentElement.scrollHeight - window.innerHeight;
      const distance = Math.max(0, Math.min(top, limit)) - start;
      if (Math.abs(distance) < 2) { done(); return; }

      // 가까우면 더 짧게. 멀어도 320ms를 넘기지 않는다.
      const duration = Math.min(320, Math.max(160, Math.abs(distance) * 0.25));
      const began = performance.now();
      const step = (now: number) => {
        const progress = Math.min(1, (now - began) / duration);
        window.scrollTo({ top: start + distance * easeOut(progress), behavior: 'instant' as ScrollBehavior });
        if (progress < 1) animation = requestAnimationFrame(step);
        else done();
      };
      animation = requestAnimationFrame(step);
    }

    // 이동하는 도중 사용자가 직접 굴리면 즉시 손을 뗀다 — 화면을 두고 다투지 않는다.
    function stopGlide() {
      if (!locked) return;
      cancelAnimationFrame(animation);
      locked = false;
      onScroll();
    }
    window.addEventListener('wheel', stopGlide, { passive: true });
    window.addEventListener('touchstart', stopGlide, { passive: true });

    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        const target = targets[index];
        // 새 탭·다운로드 같은 보조 클릭은 브라우저에 맡긴다
        if (!target || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();

        locked = true;
        current = -1; // 같은 항목을 다시 눌러도 목차가 제자리를 잡도록
        activate(index);

        // 헤딩에 걸어 둔 scroll-margin-top(고정 헤더 높이 + 여백)을 그대로 쓴다
        const offset = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        glideTo(top, () => {
          locked = false;
          history.replaceState(null, '', link.hash);
        });
      });
    });

    update();
  })();
</script>
