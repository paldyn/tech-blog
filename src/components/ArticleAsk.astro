<div id="article-assistant-root" class="article-ai-root" data-article-ai-root>
  <div class="article-ai-layer">
    <button
      type="button"
      class="article-ai-trigger"
      aria-haspopup="dialog"
      aria-controls="article-ai-panel"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
        <path d="M20 3v4"></path>
        <path d="M22 5h-4"></path>
        <path d="M4 17v2"></path>
        <path d="M5 18H3"></path>
      </svg>
      <span>AI에게 질문하기</span>
    </button>

    <button type="button" class="article-selection-ask" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
        <path d="M20 3v4"></path>
        <path d="M22 5h-4"></path>
        <path d="M4 17v2"></path>
        <path d="M5 18H3"></path>
      </svg>
      AI에게 물어보기
    </button>

    <section
      id="article-ai-panel"
      class="article-ai-panel"
      data-placement="sheet"
      role="dialog"
      aria-labelledby="article-ai-title"
      aria-describedby="article-ai-disclosure"
      hidden
    >
      <header class="article-ai-bar">
        <p id="article-ai-title"><span aria-hidden="true"></span> PALDYN / ARTICLE AI</p>
        <button type="button" class="article-ai-reset" title="대화를 비우고 새로 시작" hidden>새 대화</button>
        <button type="button" class="article-ai-close" aria-label="AI 질문 패널 닫기" title="닫기">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </header>

      <div class="article-ai-content" aria-busy="false">
        <div class="article-ai-empty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
            <path d="M20 3v4"></path>
            <path d="M22 5h-4"></path>
            <path d="M4 17v2"></path>
            <path d="M5 18H3"></path>
          </svg>
          <p>글의 개념, 수식, 코드에 대해 물어보세요.</p>
          <span>질문과 관련된 문단을 골라 답변의 문맥으로 사용합니다.</span>
        </div>

        <ol
          class="article-ai-thread"
          aria-label="AI 대화"
          aria-live="polite"
          aria-relevant="additions text"
          role="log"
          hidden
        ></ol>

        <!--
          한 차례의 골격. 스크립트로 만든 노드에는 Astro 스코프 속성이 붙지 않아
          이 파일의 스타일이 걸리지 않는다. 마크업에 두고 복제해서 쓴다.
        -->
        <template class="article-ai-turn-template">
          <li class="article-ai-turn">
            <div class="article-ai-ask">
              <blockquote hidden></blockquote>
              <p></p>
            </div>
            <div class="article-ai-reply" data-status="loading">
              <p class="article-ai-status">
                <span class="article-ai-status-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="article-ai-status-label">생각 중</span>
                <span class="article-ai-status-time"> · 0초</span>
                <button type="button" class="article-ai-retry" aria-label="다시 시도" title="다시 시도" hidden>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path>
                    <path d="M21 3v5h-5"></path>
                  </svg>
                </button>
              </p>
              <div class="article-ai-markdown"></div>
            </div>
          </li>
        </template>
      </div>

      <!--
        선택 본문과 입력창은 한 묶음이다 — 높이 조절 손잡이가 둘 위에 함께 얹혀야
        인용구 밑줄처럼 보이지 않는다.
      -->
      <div class="article-ai-composer">
        <div
          class="article-ai-resize-handle"
          role="slider"
          aria-label="질문 입력 영역 높이 조절"
          aria-orientation="vertical"
          aria-valuemin="142"
          aria-valuemax="320"
          aria-valuenow="170"
          tabindex="0"
        ></div>

      <div class="article-ai-attachments" hidden>
      <aside class="article-ai-selection" aria-label="선택한 본문" hidden>
        <!-- 마우스를 올리면 무엇을 골랐는지 위로 펼친다 -->
        <div class="article-ai-picks"></div>
        <span class="article-ai-selection-chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            <path d="M13 8H7"></path>
            <path d="M17 12H7"></path>
          </svg>
          <span class="article-ai-selection-count"></span>
          <button type="button" class="article-ai-selection-clear" aria-label="선택 모두 해제" title="모두 해제">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </button>
        </span>
      </aside>

      <aside class="article-ai-images" aria-label="붙여넣은 이미지" hidden>
        <div class="article-ai-shots"></div>
        <span class="article-ai-selection-chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <circle cx="9" cy="9" r="2"></circle>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
          </svg>
          <span class="article-ai-image-count"></span>
          <button type="button" class="article-ai-images-clear" aria-label="이미지 모두 빼기" title="모두 빼기">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </button>
        </span>
      </aside>
      </div>

      <!-- 붙여넣은 이미지 한 장의 골격 -->
      <template class="article-ai-shot-template">
        <span class="article-ai-shot">
          <img alt="" />
          <button type="button" class="article-ai-pick-clear" aria-label="이 이미지 빼기" title="빼기">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </button>
        </span>
      </template>

      <!-- 미리보기 한 줄의 골격. 스크립트가 만든 노드에는 스코프 속성이 붙지 않는다. -->
      <template class="article-ai-pick-template">
        <span class="article-ai-pick">
          <span class="article-ai-pick-text"></span>
          <button type="button" class="article-ai-pick-clear" aria-label="이 문장 빼기" title="빼기">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </button>
        </span>
      </template>

      <form class="article-ai-form" style="height: 170px">
        <label for="article-ai-question" class="sr-only">현재 글에 질문하기</label>
        <textarea
          id="article-ai-question"
          placeholder="이 글에 대해 질문하세요"
          rows="3"
          maxlength="1000"
        ></textarea>
        <div class="article-ai-form-foot">
          <div class="article-ai-form-notes">
            <p class="article-ai-shortcut"><kbd>Enter</kbd> 전송 · <kbd>Shift + Enter</kbd> 줄바꿈</p>
            <p id="article-ai-disclosure" class="article-ai-disclosure">
              질문과 관련 본문이 AI 답변 생성을 위해 전송됩니다.<br />
              개인정보는 입력하지 마세요.
            </p>
          </div>
          <button type="submit" disabled>
            <span>전송</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 12 7-7 7 7"></path>
              <path d="M12 19V5"></path>
            </svg>
          </button>
        </div>
      </form>
      </div>
    </section>
  </div>
</div>

<script>
  import {
    articleAskErrorMessage,
    articleAskRetryAfter,
    articleAskWaitMessage,
    isArticleQuotaExhausted,
    buildArticleConversationContext,
    buildArticleQuestionContext,
    buildArticleSelectionContext,
    combineArticleSelections,
    MAX_PASTED_IMAGES,
    pickPastedImages,
    prepareArticleImage,
    calculateArticleMobileViewport,
    calculateArticlePanelGeometry,
    captureArticleTextSelection,
    normalizeArticleText,
    requestArticleAnswer,
    type ArticleAskPayload,
    type ArticleConversationEntry,
    type ArticleImageAttachment,
    type ArticleTextSelection,
  } from '../lib/articleAsk';

  /** 화면에 그려진 한 차례. 답변을 마친 차례만 다음 질문의 문맥으로 넘어간다. */
  interface ConversationTurn extends ArticleConversationEntry {
    element: HTMLLIElement;
    reply: HTMLElement;
    status: HTMLElement;
    label: HTMLElement;
    time: HTMLElement;
    retry: HTMLButtonElement;
    markdown: HTMLElement;
    /** 다시 시도할 때 그대로 다시 보낸다 — 그때 딛고 있던 문맥까지 같이. */
    payload: ArticleAskPayload | null;
    /** 이 요청이 만든 차례인지. 새 질문이 끼어들면 답 없는 차례만 걷어낸다. */
    fresh: boolean;
    error: string;
    exhausted: boolean;
    /** 한도가 풀리기를 기다리는 중인 오류인지. 남은 초를 여기에 세어 보여 준다. */
    waiting: boolean;
  }

  interface ActiveSelection {
    context: string;
    text: string;
  }

  const REQUEST_TIMEOUT_MS = 45_000;
  const DEFAULT_COMPOSER_HEIGHT = 170;
  const MIN_COMPOSER_HEIGHT = 142;
  const MAX_COMPOSER_HEIGHT = 320;
  const MOBILE_PANEL_BREAKPOINT = 640;
  const MOBILE_LANDSCAPE_MAX_WIDTH = 960;
  const MOBILE_LANDSCAPE_MAX_HEIGHT = 520;
  const MOBILE_KEYBOARD_MIN_INSET = 120;
  const MOBILE_KEYBOARD_MIN_COMPOSER_HEIGHT = 108;

  const root = document.querySelector<HTMLElement>('[data-article-ai-root]');
  const article = root?.closest<HTMLElement>('.post') ?? null;
  const prose = article?.querySelector<HTMLElement>('[data-article-body]') ?? null;
  const titleElement = article?.querySelector<HTMLElement>('[data-article-title]') ?? null;
  const descriptionElement = article?.querySelector<HTMLElement>('.post-header .description') ?? null;

  const trigger = root?.querySelector<HTMLButtonElement>('.article-ai-trigger') ?? null;
  const selectionButton = root?.querySelector<HTMLButtonElement>('.article-selection-ask') ?? null;
  const panel = root?.querySelector<HTMLElement>('.article-ai-panel') ?? null;
  const closeButton = root?.querySelector<HTMLButtonElement>('.article-ai-close') ?? null;
  const content = root?.querySelector<HTMLElement>('.article-ai-content') ?? null;
  const selectionBox = root?.querySelector<HTMLElement>('.article-ai-selection') ?? null;
  const picksBox = root?.querySelector<HTMLElement>('.article-ai-picks') ?? null;
  const selectionCount = root?.querySelector<HTMLElement>('.article-ai-selection-count') ?? null;
  const selectionClear = root?.querySelector<HTMLButtonElement>('.article-ai-selection-clear') ?? null;
  const pickTemplate = root?.querySelector<HTMLTemplateElement>('.article-ai-pick-template') ?? null;
  const attachments = root?.querySelector<HTMLElement>('.article-ai-attachments') ?? null;
  const imagesBox = root?.querySelector<HTMLElement>('.article-ai-images') ?? null;
  const shotsBox = root?.querySelector<HTMLElement>('.article-ai-shots') ?? null;
  const imageCount = root?.querySelector<HTMLElement>('.article-ai-image-count') ?? null;
  const imagesClear = root?.querySelector<HTMLButtonElement>('.article-ai-images-clear') ?? null;
  const shotTemplate = root?.querySelector<HTMLTemplateElement>('.article-ai-shot-template') ?? null;
  const emptyState = root?.querySelector<HTMLElement>('.article-ai-empty') ?? null;
  const thread = root?.querySelector<HTMLOListElement>('.article-ai-thread') ?? null;
  const resetButton = root?.querySelector<HTMLButtonElement>('.article-ai-reset') ?? null;
  const turnTemplate = root?.querySelector<HTMLTemplateElement>('.article-ai-turn-template') ?? null;
  const form = root?.querySelector<HTMLFormElement>('.article-ai-form') ?? null;
  const resizeHandle = root?.querySelector<HTMLElement>('.article-ai-resize-handle') ?? null;
  const textarea = root?.querySelector<HTMLTextAreaElement>('#article-ai-question') ?? null;
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
  const submitLabel = submitButton?.querySelector<HTMLElement>('span') ?? null;

  let isOpen = false;
  let loading = false;
  const activeSelections: ActiveSelection[] = [];
  const activeImages: ArticleImageAttachment[] = [];
  let selectionPrompt: ArticleTextSelection | null = null;
  const turns: ConversationTurn[] = [];
  let pendingTurn: ConversationTurn | null = null;
  let requestController: AbortController | null = null;
  let requestSerial = 0;
  // 한도가 풀리는 시각. 그전에는 보내지 않는다 — 거절당한 요청도 한도를 먹어서,
  // 막힌 채 두드릴수록 풀리는 시각이 오히려 뒤로 밀린다(40초가 50초를 기다려도 28초였다).
  let cooldownUntil = 0;
  let cooldownTimer = 0;
  let thinkingStartedAt = 0;
  let thinkingTimer = 0;
  let selectionFrame = 0;
  let pointerSelecting = false;
  let geometryFrame = 0;
  let composerHeight = DEFAULT_COMPOSER_HEIGHT;
  let returnFocus: HTMLElement | null = null;
  let resizeStart: { pointerId: number; y: number; height: number } | null = null;
  let mobileViewportBaseline: { height: number; width: number } | null = null;
  let mobileKeyboardOpen = false;

  function clamp(value: number, min: number, max: number): number {
    return Math.min(max, Math.max(min, value));
  }

  function readTitle(): string {
    return normalizeArticleText(titleElement?.textContent ?? document.title.split('—')[0] ?? '');
  }

  function fallbackContext(): string {
    return normalizeArticleText(descriptionElement?.textContent ?? '');
  }

  function renderSelectionPrompt(): void {
    if (!selectionButton) return;
    selectionButton.hidden = !selectionPrompt;
    if (!selectionPrompt) return;

    selectionButton.style.left = `${selectionPrompt.placement.left}px`;
    selectionButton.style.top = `${selectionPrompt.placement.top}px`;
    selectionButton.style.setProperty(
      '--selection-ask-shift',
      selectionPrompt.placement.above ? '-100%' : '0%',
    );
  }

  /**
   * 붙인 문장은 칩 하나로 세어 보여 준다 — 내용이 길면 입력 영역을 잡아먹는다.
   * 무엇을 골랐는지는 마우스를 올렸을 때 위로 펼쳐서 보여 준다.
   */
  function renderSelectionChips(): void {
    if (!selectionBox || !picksBox || !selectionCount || !pickTemplate) return;
    selectionBox.hidden = activeSelections.length === 0;
    selectionCount.textContent = `텍스트 ${activeSelections.length}개 선택`;
    picksBox.replaceChildren();

    activeSelections.forEach((selection, index) => {
      const pick = pickTemplate.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
      if (!pick) return;
      // 한 줄로 보여 주므로 줄바꿈은 공백으로 눕힌다. 자르는 일은 CSS가 맡는다.
      const label = selection.text.replace(/\s+/g, ' ').trim();
      const text = pick.querySelector<HTMLElement>('.article-ai-pick-text');
      if (text) {
        text.textContent = `“${label}”`;
        text.title = label;
      }
      pick
        .querySelector<HTMLButtonElement>('.article-ai-pick-clear')
        ?.addEventListener('click', () => clearSelectionAt(index));
      picksBox.appendChild(pick);
    });
  }

  /** 붙여넣은 이미지도 같은 방식이다 — 개수만 세고, 손이 닿으면 썸네일을 펼친다. */
  function renderImageChips(): void {
    if (!imagesBox || !shotsBox || !imageCount || !shotTemplate) return;
    imagesBox.hidden = activeImages.length === 0;
    imageCount.textContent = `이미지 ${activeImages.length}개`;
    shotsBox.replaceChildren();

    activeImages.forEach((image, index) => {
      const shot = shotTemplate.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
      if (!shot) return;
      const img = shot.querySelector('img');
      if (img) {
        img.src = image.preview;
        img.alt = image.name;
      }
      shot
        .querySelector<HTMLButtonElement>('.article-ai-pick-clear')
        ?.addEventListener('click', () => {
          activeImages.splice(index, 1);
          renderPanelState();
          focusTextarea();
        });
      shotsBox.appendChild(shot);
    });
  }

  /** 붙여넣은 이미지를 줄여서 받아 둔다. 워커가 인라인으로 실어 보내기 때문이다. */
  async function attachImages(files: File[]): Promise<void> {
    const room = MAX_PASTED_IMAGES - activeImages.length;
    if (room <= 0) return;

    for (const file of files.slice(0, room)) {
      const image = await prepareArticleImage(file);
      if (image) activeImages.push(image);
    }
    renderPanelState();
  }

  function renderPanelState(): void {
    if (!panel || !content || !textarea || !submitButton) return;

    panel.toggleAttribute('data-has-selection', activeSelections.length > 0);
    renderSelectionChips();
    renderImageChips();
    if (attachments) {
      attachments.hidden = activeSelections.length === 0 && activeImages.length === 0;
    }

    const hasTurns = turns.length > 0;
    panel.toggleAttribute('data-has-turns', hasTurns);
    if (emptyState) emptyState.hidden = hasTurns;
    if (thread) thread.hidden = !hasTurns;
    if (resetButton) resetButton.hidden = !hasTurns;

    content.setAttribute('aria-busy', String(loading));
    textarea.readOnly = loading;
    textarea.setAttribute('aria-disabled', String(loading));
    renderSendButton();
  }

  /** 전송 단추만 다시 그린다. 한도가 걸린 동안에는 남은 초를 세어 보여 준다. */
  function renderSendButton(): void {
    if (!textarea || !submitButton) return;
    const left = cooldownLeft();
    submitButton.disabled = loading || left > 0 || !textarea.value.trim();
    if (submitLabel) submitLabel.textContent = left > 0 ? `${left}초` : '전송';
    submitButton.title = left > 0 ? `한도가 풀리기까지 ${left}초` : '';
  }

  /** 한도가 풀리기까지 남은 초. 0이면 다시 보낼 수 있다. */
  function cooldownLeft(): number {
    if (!cooldownUntil) return 0;
    return Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1_000));
  }

  /** 워커가 알려 준 대기 시간을 건다. 이미 걸려 있으면 더 먼 쪽을 남긴다. */
  function startCooldown(seconds: number): void {
    if (seconds <= 0) return;
    cooldownUntil = Math.max(cooldownUntil, Date.now() + seconds * 1_000);
    if (cooldownTimer) return;
    cooldownTimer = window.setInterval(tickCooldown, 500);
    tickCooldown();
  }

  /** 남은 초를 흘려보낸다 — 단추에도, 기다리는 차례의 문구에도. */
  function tickCooldown(): void {
    const left = cooldownLeft();
    for (const turn of turns) {
      if (!turn.waiting) continue;
      turn.error = articleAskWaitMessage(left);
      if (turn.reply.dataset.status === 'error') turn.label.textContent = turn.error;
    }
    if (left === 0) {
      cooldownUntil = 0;
      window.clearInterval(cooldownTimer);
      cooldownTimer = 0;
    }
    syncRetryButtons();
    renderSendButton();
  }

  function stopThinkingTimer(): void {
    if (thinkingTimer) window.clearInterval(thinkingTimer);
    thinkingTimer = 0;
  }

  function elapsedLabel(): string {
    return ` · ${Math.floor((Date.now() - thinkingStartedAt) / 1_000)}초`;
  }

  function startThinkingTimer(): void {
    stopThinkingTimer();
    thinkingStartedAt = Date.now();
    if (pendingTurn) pendingTurn.time.textContent = ' · 0초';
    thinkingTimer = window.setInterval(() => {
      if (pendingTurn) pendingTurn.time.textContent = elapsedLabel();
    }, 1_000);
  }

  /** 대화는 아래로 자란다. 새 차례가 붙으면 그 자리가 보이게 따라간다. */
  function scrollThreadToEnd(): void {
    if (!content) return;
    content.scrollTop = content.scrollHeight;
  }

  function appendTurn(
    question: string,
    quoted: string,
    shots: readonly string[] = [],
  ): ConversationTurn | null {
    if (!turnTemplate || !thread) return null;

    const element = turnTemplate.content.firstElementChild?.cloneNode(true) as HTMLLIElement | null;
    if (!element) return null;

    const quote = element.querySelector<HTMLElement>('.article-ai-ask blockquote');
    if (quote) {
      quote.hidden = !quoted;
      quote.textContent = quoted;
    }
    // 무엇을 붙여 물었는지 그 차례에 남긴다 — 칩은 답이 오면 사라진다.
    if (shots.length > 0) {
      const strip = document.createElement('span');
      strip.className = 'article-ai-ask-shots';
      for (const src of shots) {
        const img = document.createElement('img');
        img.src = src;
        img.alt = '붙여넣은 이미지';
        strip.appendChild(img);
      }
      element.querySelector('.article-ai-ask')?.prepend(strip);
    }

    const askText = element.querySelector<HTMLElement>('.article-ai-ask p');
    if (askText) askText.textContent = question;

    const reply = element.querySelector<HTMLElement>('.article-ai-reply');
    const status = element.querySelector<HTMLElement>('.article-ai-status');
    const label = element.querySelector<HTMLElement>('.article-ai-status-label');
    const time = element.querySelector<HTMLElement>('.article-ai-status-time');
    const retry = element.querySelector<HTMLButtonElement>('.article-ai-retry');
    const markdown = element.querySelector<HTMLElement>('.article-ai-markdown');
    if (!reply || !status || !label || !time || !retry || !markdown) return null;

    const turn: ConversationTurn = {
      question,
      answer: '',
      element,
      reply,
      status,
      label,
      time,
      retry,
      markdown,
      payload: null,
      fresh: true,
      error: '',
      exhausted: false,
      waiting: false,
    };
    retry.addEventListener('click', () => {
      if (loading || cooldownLeft() > 0 || !turn.payload) return;
      void runTurn(turn);
    });
    turns.push(turn);
    thread.appendChild(element);
    syncRetryButtons();
    return turn;
  }

  function dropTurn(turn: ConversationTurn): void {
    const index = turns.indexOf(turn);
    if (index >= 0) turns.splice(index, 1);
    turn.element.remove();
    syncRetryButtons();
  }

  function abortRequest(): void {
    requestSerial += 1;
    requestController?.abort();
    requestController = null;
    loading = false;
    stopThinkingTimer();
    // 답을 받지 못한 새 차례는 남겨 둘 이유가 없다 — 질문만 떠 있으면 실패로 읽힌다.
    // 다시 시도 중이던 차례는 이미 화면에 있던 것이므로 오류 상태로 되돌린다.
    if (pendingTurn?.fresh) dropTurn(pendingTurn);
    else if (pendingTurn)
      showTurnError(pendingTurn, pendingTurn.error, pendingTurn.exhausted, pendingTurn.waiting);
    pendingTurn = null;
  }

  function composerBounds(): { min: number; max: number } {
    if (mobileKeyboardOpen) {
      return {
        min: MOBILE_KEYBOARD_MIN_COMPOSER_HEIGHT,
        max: MIN_COMPOSER_HEIGHT,
      };
    }

    const panelHeight = panel?.getBoundingClientRect().height ?? window.innerHeight;
    return {
      min: MIN_COMPOSER_HEIGHT,
      max: Math.max(MIN_COMPOSER_HEIGHT, Math.min(MAX_COMPOSER_HEIGHT, panelHeight - 165)),
    };
  }

  function syncResizeHandleAccessibility(): void {
    if (!resizeHandle) return;

    if (mobileKeyboardOpen) {
      resizeHandle.removeAttribute('role');
      resizeHandle.setAttribute('aria-hidden', 'true');
      resizeHandle.removeAttribute('aria-label');
      resizeHandle.removeAttribute('aria-orientation');
      resizeHandle.removeAttribute('aria-valuemin');
      resizeHandle.removeAttribute('aria-valuemax');
      resizeHandle.removeAttribute('aria-valuenow');
      resizeHandle.tabIndex = -1;
      return;
    }

    const bounds = composerBounds();
    resizeHandle.setAttribute('role', 'slider');
    resizeHandle.removeAttribute('aria-hidden');
    resizeHandle.setAttribute('aria-label', '질문 입력 영역 높이 조절');
    resizeHandle.setAttribute('aria-orientation', 'vertical');
    resizeHandle.setAttribute('aria-valuemin', String(MIN_COMPOSER_HEIGHT));
    resizeHandle.setAttribute('aria-valuemax', String(Math.round(bounds.max)));
    resizeHandle.setAttribute('aria-valuenow', String(Math.round(composerHeight)));
    resizeHandle.tabIndex = 0;
  }

  function setComposerHeight(next: number): void {
    if (!form || !resizeHandle) return;
    const bounds = composerBounds();
    composerHeight = clamp(next, bounds.min, bounds.max);
    form.style.height = `${composerHeight}px`;
    syncResizeHandleAccessibility();
  }

  function syncMobileViewport(): void {
    if (!panel) return;
    const viewport = window.visualViewport;
    const viewportWidth = Math.max(
      0,
      viewport?.width ?? document.documentElement.clientWidth,
    );
    const viewportHeight = Math.max(0, viewport?.height ?? window.innerHeight);
    const measuredLayoutHeight = Math.max(
      viewportHeight,
      window.innerHeight,
      document.documentElement.clientHeight,
    );
    const mobileSheet = window.innerWidth <= MOBILE_PANEL_BREAKPOINT || (
      viewportWidth <= MOBILE_LANDSCAPE_MAX_WIDTH &&
      measuredLayoutHeight <= MOBILE_LANDSCAPE_MAX_HEIGHT
    );

    if (!mobileSheet) {
      mobileViewportBaseline = null;
      mobileKeyboardOpen = false;
      document.body.removeAttribute('data-article-ai-top-cramped');
      document.body.removeAttribute('data-article-ai-mobile-viewport');
      panel.removeAttribute('data-mobile-viewport');
      panel.removeAttribute('data-mobile-compact');
      panel.removeAttribute('data-mobile-keyboard');
      for (const property of [
        '--article-ai-mobile-height',
        '--article-ai-mobile-left',
        '--article-ai-mobile-top',
        '--article-ai-mobile-width',
      ]) {
        panel.style.removeProperty(property);
        document.body.style.removeProperty(property);
      }
      syncResizeHandleAccessibility();
      return;
    }

    const previousBaseline = mobileViewportBaseline;
    const orientationChanged = Boolean(
      previousBaseline && Math.abs(previousBaseline.width - viewportWidth) >= 80,
    );
    const baselineHeight = !previousBaseline || orientationChanged
      ? measuredLayoutHeight
      : Math.max(previousBaseline.height, measuredLayoutHeight);
    mobileViewportBaseline = { height: baselineHeight, width: viewportWidth };
    mobileKeyboardOpen = Boolean(
      viewport && baselineHeight - viewportHeight >= MOBILE_KEYBOARD_MIN_INSET,
    );

    const mobile = calculateArticleMobileViewport(
      viewportWidth,
      viewportHeight,
      viewport?.offsetLeft ?? 0,
      viewport?.offsetTop ?? 0,
      mobileKeyboardOpen,
    );

    if (mobileKeyboardOpen) {
      resizeStart = null;
      form?.removeAttribute('data-resizing');
      composerHeight = clamp(
        mobile.height - 49 - 24,
        MOBILE_KEYBOARD_MIN_COMPOSER_HEIGHT,
        MIN_COMPOSER_HEIGHT,
      );
    } else {
      composerHeight = Math.max(MIN_COMPOSER_HEIGHT, composerHeight);
    }

    panel.setAttribute('data-mobile-viewport', 'true');
    panel.toggleAttribute('data-mobile-compact', viewportHeight <= 520);
    if (mobileKeyboardOpen) panel.setAttribute('data-mobile-keyboard', 'true');
    else panel.removeAttribute('data-mobile-keyboard');
    document.body.setAttribute('data-article-ai-mobile-viewport', '');
    const properties = {
      '--article-ai-mobile-height': `${mobile.height}px`,
      '--article-ai-mobile-left': `${mobile.left}px`,
      '--article-ai-mobile-top': `${mobile.top}px`,
      '--article-ai-mobile-width': `${mobile.width}px`,
    };

    const headerBottom = document
      .querySelector<HTMLElement>('.site-header')
      ?.getBoundingClientRect().bottom ?? 0;
    const titleBar = document.querySelector<HTMLElement>('[data-article-titlebar]');
    const titleBarBottom =
      titleBar?.getAttribute('aria-hidden') === 'false'
        ? titleBar.getBoundingClientRect().bottom
        : 0;
    const viewportTop = Math.max(0, viewport?.offsetTop ?? 0);
    const goTopTop = mobile.top - 56;
    document.body.toggleAttribute(
      'data-article-ai-top-cramped',
      goTopTop < Math.max(viewportTop + 12, headerBottom + 8, titleBarBottom + 8),
    );

    for (const [property, value] of Object.entries(properties)) {
      panel.style.setProperty(property, value);
      document.body.style.setProperty(property, value);
    }

    setComposerHeight(composerHeight);
  }

  function syncPanelGeometry(): void {
    if (!panel || !prose) return;
    const rect = prose.getBoundingClientRect();
    const toc = article?.querySelector<HTMLElement>('.toc') ?? null;
    const tocRect = toc && getComputedStyle(toc).display !== 'none' ? toc.getBoundingClientRect() : null;
    const geometry = calculateArticlePanelGeometry(
      document.documentElement.clientWidth,
      {
        right: Math.max(rect.right, tocRect?.right ?? rect.right),
      },
    );

    panel.dataset.placement = geometry.placement;
    panel.style.setProperty('--article-ai-panel-left', `${geometry.left}px`);
    panel.style.setProperty('--article-ai-panel-width', `${geometry.width}px`);
    document.body.dataset.articleAiPlacement = geometry.placement;
    syncMobileViewport();
  }

  function scheduleGeometry(): void {
    if (!isOpen || geometryFrame) return;
    geometryFrame = window.requestAnimationFrame(() => {
      geometryFrame = 0;
      syncPanelGeometry();
      setComposerHeight(composerHeight);
    });
  }

  function focusTextarea(): void {
    try {
      textarea?.focus({ preventScroll: true });
    } catch {
      textarea?.focus();
    }
  }

  function openPanel(opener: HTMLElement | null): void {
    if (!panel || !trigger) return;
    if (!isOpen) returnFocus = opener;
    isOpen = true;
    trigger.hidden = true;
    panel.hidden = false;
    document.body.dataset.articleAiOpen = '';
    syncPanelGeometry();
    if (panel.hasAttribute('data-mobile-viewport') && !mobileKeyboardOpen) {
      composerHeight = MIN_COMPOSER_HEIGHT;
    }
    setComposerHeight(composerHeight);
    focusTextarea();
  }

  function closePanel(): void {
    if (!isOpen || !panel || !trigger) return;
    const keyboardWasOpen = mobileKeyboardOpen;
    abortRequest();
    isOpen = false;
    panel.hidden = true;
    trigger.hidden = false;
    document.body.removeAttribute('data-article-ai-open');
    document.body.removeAttribute('data-article-ai-placement');
    document.body.removeAttribute('data-article-ai-top-cramped');
    document.body.removeAttribute('data-article-ai-mobile-viewport');
    mobileViewportBaseline = null;
    mobileKeyboardOpen = false;
    panel.removeAttribute('data-mobile-viewport');
    panel.removeAttribute('data-mobile-compact');
    panel.removeAttribute('data-mobile-keyboard');
    for (const property of [
      '--article-ai-mobile-height',
      '--article-ai-mobile-left',
      '--article-ai-mobile-top',
      '--article-ai-mobile-width',
    ]) {
      panel.style.removeProperty(property);
      document.body.style.removeProperty(property);
    }
    if (keyboardWasOpen && form) {
      composerHeight = MIN_COMPOSER_HEIGHT;
      form.style.height = `${composerHeight}px`;
    }
    syncResizeHandleAccessibility();
    renderPanelState();

    const destination = returnFocus?.isConnected && !returnFocus.hidden ? returnFocus : trigger;
    returnFocus = null;
    window.requestAnimationFrame(() => destination.focus({ preventScroll: true }));
  }

  /** 대화를 통째로 비운다. 선택 본문과 달리 저절로 사라지지 않으므로 버튼으로만 부른다. */
  function clearConversation(): void {
    abortRequest();
    turns.splice(0, turns.length);
    thread?.replaceChildren();
    renderPanelState();
  }

  function applySelection(): void {
    if (!prose || !selectionPrompt) return;
    const wasOpen = isOpen;
    const prompt = selectionPrompt;
    abortRequest();
    // 이미 붙인 문장을 다시 고르면 칩만 늘고 문맥은 그대로다 — 한 번만 둔다.
    const already = activeSelections.some((piece) => piece.text === prompt.selectedText);
    if (!already) {
      activeSelections.push({
        context: buildArticleSelectionContext(prose, prompt.range, prompt.selectedText),
        text: prompt.selectedText,
      });
    }
    selectionPrompt = null;
    renderSelectionPrompt();
    renderPanelState();
    openPanel(wasOpen ? returnFocus : selectionButton);
    focusTextarea();
  }

  function clearSelectionAt(index: number): void {
    if (index < 0 || index >= activeSelections.length) return;
    abortRequest();
    activeSelections.splice(index, 1);
    renderPanelState();
    focusTextarea();
  }

  function clearAllSelections(): void {
    if (activeSelections.length === 0) return;
    activeSelections.length = 0;
    renderPanelState();
  }

  function showTurnLoading(turn: ConversationTurn): void {
    turn.reply.dataset.status = 'loading';
    turn.status.hidden = false;
    turn.label.textContent = '생각 중';
    turn.time.hidden = false;
    turn.retry.hidden = true;
    turn.markdown.replaceChildren();
  }

  /**
   * 다시 시도는 마지막 차례에만 둔다. 줄줄이 실패했을 때 모든 줄에 단추가 서면
   * 어느 것을 눌러야 할지부터 고르게 되고, 위쪽 질문을 다시 보내면 대화 순서도 꼬인다.
   * 하루치를 다 썼을 때도 내놓지 않는다 — 눌러도 리셋 전까지 막힌다.
   */
  function syncRetryButtons(): void {
    const last = turns[turns.length - 1] ?? null;
    const left = cooldownLeft();
    for (const turn of turns) {
      const offer =
        turn === last &&
        Boolean(turn.payload) &&
        !turn.exhausted &&
        turn.reply.dataset.status === 'error';
      turn.retry.hidden = !offer;
      // 한도가 안 풀린 동안에는 누르지 못하게 둔다. 누르면 그 요청까지 한도를 먹는다.
      turn.retry.disabled = left > 0;
      turn.retry.title = left > 0 ? `한도가 풀리기까지 ${left}초` : '다시 시도';
    }
  }

  function showTurnError(
    turn: ConversationTurn,
    message: string,
    exhausted = false,
    waiting = false,
  ): void {
    turn.error = message;
    turn.exhausted = exhausted;
    turn.waiting = waiting;
    turn.reply.dataset.status = 'error';
    turn.status.hidden = false;
    turn.label.textContent = message;
    turn.time.hidden = true;
    syncRetryButtons();
  }

  /** 한 차례를 보낸다. 첫 질문도, 다시 시도도 이 길을 탄다. */
  async function runTurn(turn: ConversationTurn): Promise<void> {
    if (!turn.payload || loading || cooldownLeft() > 0) return;

    abortRequest();
    const controller = new AbortController();
    const serial = requestSerial + 1;
    requestSerial = serial;
    requestController = controller;
    loading = true;
    pendingTurn = turn;
    showTurnLoading(turn);
    startThinkingTimer();
    renderPanelState();
    scrollThreadToEnd();

    const timeout = window.setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);

    try {
      const response = await requestArticleAnswer(turn.payload, controller.signal);

      if (requestSerial !== serial) return;
      const { renderAiMarkdown } = await import('../lib/aiMarkdown');
      if (requestSerial !== serial) return;

      turn.answer = response.answer;
      turn.error = '';
      turn.fresh = false;
      turn.reply.dataset.status = 'done';
      turn.status.hidden = true;
      syncRetryButtons();
      turn.markdown.innerHTML = renderAiMarkdown(response.answer);

    } catch (caught) {
      if (requestSerial !== serial) return;
      turn.fresh = false;
      const wait = articleAskRetryAfter(caught);
      showTurnError(turn, articleAskErrorMessage(caught), isArticleQuotaExhausted(caught), wait > 0);
      startCooldown(wait);
    } finally {
      window.clearTimeout(timeout);
      if (requestSerial === serial) {
        requestController = null;
        loading = false;
        pendingTurn = null;
        stopThinkingTimer();
        renderPanelState();
        scrollThreadToEnd();
      }
    }
  }

  async function submitQuestion(): Promise<void> {
    if (!textarea || !prose || loading || cooldownLeft() > 0) return;
    const question = textarea.value.trim();
    if (!question) return;

    // 이 질문이 딛고 선 선택들. 답이 오면 놓아 주므로 여기서 붙잡아 둔다.
    const picked = activeSelections.slice();
    const merged = combineArticleSelections(picked);
    const images = activeImages.slice();
    // 답변을 마친 차례만 문맥으로 보낸다. 실패한 차례를 넣으면 모델이 빈 답을 이어받는다.
    const history: ArticleConversationEntry[] = turns
      .filter((turn) => turn.answer)
      .map((turn) => ({ question: turn.question, answer: turn.answer }));

    const turn = appendTurn(
      question,
      picked.map((piece) => piece.text).join('\n'),
      images.map((image) => image.preview),
    );
    if (!turn) return;

    // 다시 시도할 때 그대로 다시 보낸다 — 그때의 문맥·선택·이미지까지 같이.
    turn.payload = {
      title: readTitle(),
      context: buildArticleConversationContext(
        merged.context || buildArticleQuestionContext(prose, question, fallbackContext()),
        history,
      ),
      selectedText: merged.selectedText,
      images: images.map((image) => ({ data: image.data, mimeType: image.mimeType })),
      question,
    };
    // 보낸 순간 입력 묶음을 비운다 — 글자도 칩도. 실패해도 다시 시도는 그때 보낸
    // payload를 그대로 쓰므로 붙잡아 둘 이유가 없다.
    textarea.value = '';
    clearAllSelections();
    activeImages.length = 0;
    renderPanelState();

    await runTurn(turn);
  }

  function inspectSelection(): void {
    selectionFrame = 0;
    if (!prose) return;
    const next = captureArticleTextSelection(prose, document.getSelection());
    if (!next && document.activeElement === selectionButton) return;
    selectionPrompt = next;
    renderSelectionPrompt();
  }

  function scheduleSelectionInspection(): void {
    // 마우스·터치로 선택하는 중에는 CTA를 그리지 않고 포인터를 놓은 뒤 측정한다.
    if (pointerSelecting) return;
    if (selectionFrame) return;
    selectionFrame = window.requestAnimationFrame(inspectSelection);
  }

  if (
    root &&
    article &&
    prose &&
    trigger &&
    selectionButton &&
    panel &&
    closeButton &&
    form &&
    resizeHandle &&
    textarea
  ) {
    document.body.classList.add('has-article-ai');
    renderPanelState();

    resetButton?.addEventListener('click', () => {
      clearConversation();
      focusTextarea();
    });

    trigger.addEventListener('click', () => {
      activeSelections.length = 0;
      selectionPrompt = null;
      renderSelectionPrompt();
      renderPanelState();
      openPanel(trigger);
    });
    selectionButton.addEventListener('pointerdown', (event) => event.preventDefault());
    selectionButton.addEventListener('click', applySelection);
    closeButton.addEventListener('click', closePanel);
    selectionClear?.addEventListener('click', () => {
      abortRequest();
      clearAllSelections();
      focusTextarea();
    });

    // 캡처를 그대로 붙여넣는다. 파일이 섞여 오면 이미지만 집어 든다.
    textarea.addEventListener('paste', (event) => {
      const files = pickPastedImages(Array.from(event.clipboardData?.files ?? []));
      if (files.length === 0) return;
      event.preventDefault();
      void attachImages(files);
    });

    imagesClear?.addEventListener('click', () => {
      activeImages.length = 0;
      renderPanelState();
      focusTextarea();
    });

    // 칩과 펼친 목록 사이를 지날 때 잠깐 밖으로 나가도 닫히지 않게 유예를 둔다.
    // 순수 :hover로 두면 그 틈에서 목록이 사라져 안의 ✕를 누를 수가 없다.
    for (const holder of [selectionBox, imagesBox]) {
      if (!holder) continue;
      let closeTimer = 0;
      const open = () => {
        window.clearTimeout(closeTimer);
        holder.classList.add('is-open');
      };
      const close = () => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => holder.classList.remove('is-open'), 220);
      };
      holder.addEventListener('pointerenter', open);
      holder.addEventListener('pointerleave', close);
      holder.addEventListener('focusin', open);
      holder.addEventListener('focusout', close);
    }

    textarea.addEventListener('input', renderPanelState);
    textarea.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.shiftKey || event.isComposing) return;
      event.preventDefault();
      form.requestSubmit();
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void submitQuestion();
    });

    let touchStart: { x: number; y: number } | null = null;
    let previousTouchY: number | null = null;
    let touchScrollArea: HTMLElement | null = null;

    panel.addEventListener('touchstart', (event) => {
      if (event.touches.length !== 1) {
        touchStart = null;
        previousTouchY = null;
        touchScrollArea = null;
        return;
      }

      const touch = event.touches[0];
      const target = event.target instanceof Element ? event.target : null;
      const candidate = target?.closest<HTMLElement>('.article-ai-content, textarea') ?? null;
      touchStart = { x: touch.clientX, y: touch.clientY };
      previousTouchY = touch.clientY;
      touchScrollArea = candidate && panel.contains(candidate) ? candidate : null;
    }, { passive: true });

    panel.addEventListener('touchmove', (event) => {
      if (!touchStart || previousTouchY === null || event.touches.length !== 1) return;

      const touch = event.touches[0];
      const currentY = touch.clientY;
      const scrollDelta = previousTouchY - currentY;
      previousTouchY = currentY;
      const totalX = touch.clientX - touchStart.x;
      const totalY = currentY - touchStart.y;
      if (Math.abs(scrollDelta) < 0.5 || Math.abs(totalY) <= Math.abs(totalX)) return;

      const maxScrollTop = touchScrollArea
        ? Math.max(0, touchScrollArea.scrollHeight - touchScrollArea.clientHeight)
        : 0;
      const canScroll = touchScrollArea && panel.contains(touchScrollArea) && maxScrollTop > 1 &&
        (scrollDelta < 0
          ? touchScrollArea.scrollTop > 1
          : touchScrollArea.scrollTop < maxScrollTop - 1);

      // 패널의 스크롤 끝에 닿아도 뒤의 글로 제스처가 이어지지 않게 한다.
      if (!canScroll && event.cancelable) event.preventDefault();
    }, { passive: false });

    const finishTouch = (event: TouchEvent) => {
      if (event.touches.length === 1) {
        const touch = event.touches[0];
        touchStart = { x: touch.clientX, y: touch.clientY };
        previousTouchY = touch.clientY;
        return;
      }

      touchStart = null;
      previousTouchY = null;
      touchScrollArea = null;
    };

    panel.addEventListener('touchend', finishTouch, { passive: true });
    panel.addEventListener('touchcancel', finishTouch, { passive: true });

    resizeHandle.addEventListener('pointerdown', (event) => {
      if (mobileKeyboardOpen) return;
      if (event.button !== 0) return;
      event.preventDefault();
      resizeStart = {
        pointerId: event.pointerId,
        y: event.clientY,
        height: form.getBoundingClientRect().height,
      };
      resizeHandle.setPointerCapture(event.pointerId);
      form.toggleAttribute('data-resizing', true);
    });
    resizeHandle.addEventListener('pointermove', (event) => {
      if (mobileKeyboardOpen) return;
      if (!resizeStart || resizeStart.pointerId !== event.pointerId) return;
      setComposerHeight(resizeStart.height + resizeStart.y - event.clientY);
    });
    const stopResize = (event: PointerEvent) => {
      if (!resizeStart || resizeStart.pointerId !== event.pointerId) return;
      resizeStart = null;
      if (resizeHandle.hasPointerCapture(event.pointerId)) {
        resizeHandle.releasePointerCapture(event.pointerId);
      }
      form.removeAttribute('data-resizing');
    };
    resizeHandle.addEventListener('pointerup', stopResize);
    resizeHandle.addEventListener('pointercancel', stopResize);
    resizeHandle.addEventListener('lostpointercapture', () => {
      resizeStart = null;
      form.removeAttribute('data-resizing');
    });
    resizeHandle.addEventListener('keydown', (event) => {
      if (mobileKeyboardOpen) return;
      const bounds = composerBounds();
      let next: number | null = null;
      if (event.key === 'ArrowUp') next = composerHeight + 16;
      if (event.key === 'ArrowDown') next = composerHeight - 16;
      if (event.key === 'Home') next = bounds.min;
      if (event.key === 'End') next = bounds.max;
      if (next === null) return;
      event.preventDefault();
      setComposerHeight(next);
    });

    const handleSelectionChange = () => {
      // 키보드·보조기술로 만든 선택은 selectionchange 경로로 계속 지원한다.
      if (!pointerSelecting) scheduleSelectionInspection();
    };
    const handlePointerDown = (event: PointerEvent) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (selectionButton.contains(target)) return;
      if (prose.contains(target)) {
        pointerSelecting = true;
        if (selectionFrame) window.cancelAnimationFrame(selectionFrame);
        selectionFrame = 0;
        selectionPrompt = null;
        renderSelectionPrompt();
        return;
      }
      pointerSelecting = false;
      selectionPrompt = null;
      renderSelectionPrompt();
    };
    const finishPointerSelection = () => {
      if (!pointerSelecting) return;
      pointerSelecting = false;
      scheduleSelectionInspection();
    };

    document.addEventListener('selectionchange', handleSelectionChange);
    document.addEventListener('pointerdown', handlePointerDown, true);
    document.addEventListener('pointerup', finishPointerSelection, true);
    document.addEventListener('pointercancel', finishPointerSelection, true);
    prose.addEventListener('keyup', scheduleSelectionInspection);

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || event.defaultPrevented || !isOpen) return;
      const search = document.getElementById('searchOverlay');
      const lightbox = document.getElementById('image-lightbox');
      if ((search && !search.hidden) || (lightbox && !lightbox.hidden)) return;
      event.preventDefault();
      closePanel();
    });

    window.addEventListener('scroll', () => {
      scheduleGeometry();
      scheduleSelectionInspection();
    }, { passive: true });
    window.addEventListener('resize', () => {
      scheduleGeometry();
      scheduleSelectionInspection();
    }, { passive: true });
    window.addEventListener('orientationchange', scheduleGeometry, { passive: true });
    window.addEventListener('article-titlebar-visibility', scheduleGeometry);
    window.visualViewport?.addEventListener('resize', scheduleGeometry, { passive: true });
    window.visualViewport?.addEventListener('scroll', scheduleGeometry, { passive: true });

    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(scheduleGeometry).observe(prose);
    }
  }
</script>

