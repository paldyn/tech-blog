---
import { NAV_LINKS, SITE_SUFFIX } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  // 경로만으로는 어느 메뉴에 있는지 알 수 없는 화면이 켤 항목. 글 상세가 그렇다 —
  // 주소가 /posts/<슬러그>라 아카이브에 걸리지만, 실제로는 기록이나 지식에 속한다.
  activeNav?: string;
}
const { activeNav } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(base, '') || '/';
const searchIndexUrl = `${base}/search-index.json`;

const navItems = NAV_LINKS.map(({ href, label }) => ({
  href: `${base}${href}`,
  label,
  active: activeNav
    ? href === activeNav
    : pathname === href || (href !== '/' && pathname.startsWith(href)),
}));
---

<header class="site-header">
  <div class="wrap">
    <div class="header-inner">
      <a href={`${base}/`} class="nav-logo">
        <img class="logo-symbol logo-light" src={`${base}/assets/logo-symbol-dark.png`} alt="PALDYN" />
        <img class="logo-symbol logo-dark" src={`${base}/assets/logo-symbol-light.png`} alt="PALDYN" />
        <span class="logo-text">PALDYN</span>
        <span class="logo-divider">|</span>
        <span class="logo-suffix">{SITE_SUFFIX}</span>
      </a>

      <nav class="main-nav" aria-label="주요 메뉴">
        {navItems.map(({ href, label, active }) => (
          <a href={href} class:list={[{ active }]}>{label}</a>
        ))}
      </nav>

      <div class="nav-right">
        {/*
          모양은 입력창이지만 실제로는 버튼이다 — 누르면 오버레이가 열린다.
          input으로 두면 여기 칠 수 있어 보이는데 첫 글자가 오버레이로 넘어가야 해서
          두 곳에 포커스가 오가고 한글 조합이 끊긴다. 보이는 것만 맞추고 동작은 넘긴다.
        */}
        <button type="button" class="nav-search-trigger" id="navSearchTrigger" aria-label="글 검색 열기" title="검색 ( / )">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span>'/'로 검색</span>
        </button>

        <ThemeToggle />

        <button type="button" class="menu-toggle" id="navMenuToggle" aria-label="메뉴 열기" aria-expanded="false" aria-controls="mobileNav">
          <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path>
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav class="mobile-nav" id="mobileNav" aria-label="모바일 메뉴" hidden>
    <div class="wrap mobile-nav-grid">
      {navItems.map(({ href, label, active }) => (
        <a href={href} class:list={['mobile-nav-link', { active }]}>{label}</a>
      ))}
    </div>
  </nav>
</header>

{/*
  검색 오버레이는 헤더 밖에 둔다. 고정 헤더에 backdrop-filter가 걸려 있어서
  그 안에 두면 position: fixed의 기준이 화면이 아니라 헤더가 된다.
*/}
<div class="search-backdrop" id="searchOverlay" role="presentation" data-index-src={searchIndexUrl} hidden>
  <section class="search-panel" role="dialog" aria-modal="true" aria-label="글 검색">
    <div class="search-panel-input">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="searchOverlayInput"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="searchResults"
        aria-autocomplete="list"
        autocomplete="off"
        placeholder="제목, 카테고리, 태그로 검색"
      />
      <button type="button" class="search-close" aria-label="검색 닫기">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <div class="search-scopes" role="group" aria-label="검색 범위">
      <button type="button" data-scope="all" class="active" aria-pressed="true">전체<span></span></button>
      <button type="button" data-scope="record" aria-pressed="false">기록<span></span></button>
      <button type="button" data-scope="knowledge" aria-pressed="false">지식<span></span></button>
    </div>

    <ul class="search-results" id="searchResults" role="listbox" aria-label="검색 결과" hidden></ul>
    <p class="search-empty" hidden>일치하는 글이 없습니다.</p>

    <footer class="search-panel-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
      <span><kbd>↵</kbd> 열기</span>
      <span><kbd>esc</kbd> 닫기</span>
      <b class="search-count"></b>
    </footer>
  </section>
</div>

<script is:inline>
  (function () {
    var overlay = document.getElementById('searchOverlay');
    var trigger = document.getElementById('navSearchTrigger');
    var input = document.getElementById('searchOverlayInput');
    if (!overlay || !trigger || !input) return;

    var panel = overlay.querySelector('.search-panel');
    var list = overlay.querySelector('.search-results');
    var emptyNote = overlay.querySelector('.search-empty');
    var countNote = overlay.querySelector('.search-count');
    var closeBtn = overlay.querySelector('.search-close');
    var scopeButtons = [].slice.call(overlay.querySelectorAll('.search-scopes button'));

    // 결과는 전부 보여주되 한 번에 다 그리지는 않는다. 두 글자짜리 검색어는
    // 수천 건이 걸리는데 그만큼 DOM을 한 번에 만들면 글자마다 입력이 멈춘다.
    // 아래로 내려가면 이어서 그린다.
    var CHUNK = 60;

    var index = [];
    var indexLoading = null;
    var scope = 'all';
    var cursor = 0;
    var hits = [];
    var query = '';
    var drawn = 0;
    var lastFocused = null;
    var inerted = [];

    function loadIndex() {
      if (indexLoading) return indexLoading;
      var src = overlay.getAttribute('data-index-src');
      indexLoading = fetch(src, { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (data) {
          index = Array.isArray(data) ? data : [];
          updateCounts();
          return index;
        })
        .catch(function () { return []; });
      return indexLoading;
    }
    // 트리거에 마우스만 올려도 미리 받아 둔다 — 첫 글자가 바로 걸린다.
    trigger.addEventListener('pointerenter', loadIndex, { once: true });

    function updateCounts() {
      var total = index.length;
      var records = 0;
      for (var i = 0; i < index.length; i++) if (index[i].type !== 'knowledge') records++;
      var counts = { all: total, record: records, knowledge: total - records };
      scopeButtons.forEach(function (btn) {
        var el = btn.querySelector('span');
        if (el) el.textContent = String(counts[btn.getAttribute('data-scope')] || 0);
      });
    }

    function formatDate(iso) {
      return iso ? iso.replace(/-/g, '.') : '';
    }

    function inScope(item) {
      if (scope === 'all') return true;
      if (scope === 'knowledge') return item.type === 'knowledge';
      return item.type !== 'knowledge';
    }

    function setCursor(next, follow) {
      if (!hits.length) return;
      cursor = (next + hits.length) % hits.length;
      // 아직 안 그린 줄로 넘어갔으면 거기까지 그려서 따라간다. 첫 줄에서 위로 감으면
      // 마지막 줄이라 결과 전체를 그리게 되는데, 그건 사용자가 그리로 간 경우뿐이다.
      while (drawn <= cursor && drawChunk()) {}
      var rows = list.querySelectorAll('.search-hit');
      for (var i = 0; i < rows.length; i++) {
        var on = i === cursor;
        rows[i].setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) {
          input.setAttribute('aria-activedescendant', rows[i].id);
          // 마우스로 짚었을 때는 스크롤하지 않는다 — 커서 밑에서 목록이 움직인다.
          if (follow) rows[i].scrollIntoView({ block: 'nearest' });
        }
      }
    }

    function buildRow(item, query, position) {
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.className = 'search-hit';
      a.id = 'search-hit-' + position;
      a.href = item.url;
      a.setAttribute('role', 'option');
      a.setAttribute('aria-selected', position === 0 ? 'true' : 'false');

      var cat = document.createElement('span');
      cat.className = 'search-hit-category';
      cat.textContent = (item.category || 'GENERAL').toUpperCase();
      a.appendChild(cat);

      var title = document.createElement('span');
      title.className = 'search-hit-title';
      // 제목에서 검색어가 걸린 자리만 표시한다. 본문·태그로 걸린 결과는 제목에
      // 검색어가 없을 수 있고, 그때는 그냥 제목만 그린다.
      var at = item.title.toLowerCase().indexOf(query);
      if (query && at !== -1) {
        title.appendChild(document.createTextNode(item.title.slice(0, at)));
        var mark = document.createElement('mark');
        mark.textContent = item.title.slice(at, at + query.length);
        title.appendChild(mark);
        title.appendChild(document.createTextNode(item.title.slice(at + query.length)));
      } else {
        title.textContent = item.title;
      }
      a.appendChild(title);

      var meta = document.createElement('span');
      meta.className = 'search-hit-meta';
      meta.textContent = formatDate(item.pubDate);
      a.appendChild(meta);

      li.appendChild(a);
      return li;
    }

    // 줄마다 리스너를 붙이면 결과가 수천 건일 때 그만큼 쌓인다. 목록 하나로 받는다.
    list.addEventListener('pointerover', function (e) {
      var row = e.target.closest ? e.target.closest('.search-hit') : null;
      if (row) setCursor(Number(row.id.replace('search-hit-', '')), false);
    });

    // 다음 CHUNK줄을 이어 그린다. 결과를 자르지는 않는다 — 그리는 시점만 미룬다.
    function drawChunk() {
      if (drawn >= hits.length) return false;
      var end = Math.min(hits.length, drawn + CHUNK);
      var fragment = document.createDocumentFragment();
      for (var i = drawn; i < end; i++) fragment.appendChild(buildRow(hits[i], query, i));
      list.appendChild(fragment);
      drawn = end;
      return true;
    }

    // 목록이 아직 스크롤되지 않을 만큼 짧으면 채운다. 안 그러면 스크롤 이벤트가
    // 영영 안 와서 나머지를 그릴 기회가 없다.
    function fillViewport() {
      var guard = 0;
      while (drawn < hits.length && list.scrollHeight <= list.clientHeight + 240 && guard++ < 20) {
        drawChunk();
      }
    }

    var extending = false;
    list.addEventListener('scroll', function () {
      if (extending || drawn >= hits.length) return;
      extending = true;
      requestAnimationFrame(function () {
        extending = false;
        if (list.scrollTop + list.clientHeight >= list.scrollHeight - 240) {
          drawChunk();
          fillViewport();
        }
      });
    }, { passive: true });

    function render() {
      query = input.value.trim().toLowerCase();
      list.innerHTML = '';
      list.scrollTop = 0;
      cursor = 0;
      drawn = 0;
      input.removeAttribute('aria-activedescendant');

      if (!query) {
        hits = [];
        list.hidden = true;
        emptyNote.hidden = true;
        countNote.textContent = '';
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      if (!index.length) {
        countNote.textContent = '불러오는 중…';
        loadIndex().then(function () {
          if (input.value.trim().toLowerCase() === query) render();
        });
        return;
      }

      hits = index.filter(function (item) {
        return inScope(item) && item.searchText.indexOf(query) !== -1;
      });

      emptyNote.hidden = hits.length > 0;
      list.hidden = hits.length === 0;
      input.setAttribute('aria-expanded', hits.length > 0 ? 'true' : 'false');
      countNote.textContent = hits.length + '건';

      if (hits.length) {
        drawChunk();
        fillViewport();
        setCursor(0, false);
      }
    }

    function open() {
      if (!overlay.hidden) return;
      lastFocused = document.activeElement;
      overlay.hidden = false;
      // 뒤 화면은 잠근다. 오버레이 자신은 body 자식이라 건드리지 않는다.
      inerted = [];
      [].forEach.call(document.body.children, function (el) {
        if (el === overlay || el.hasAttribute('inert')) return;
        el.setAttribute('inert', '');
        inerted.push(el);
      });
      document.body.style.overflow = 'hidden';
      loadIndex();
      input.focus();
      render();
    }

    function close() {
      if (overlay.hidden) return;
      overlay.hidden = true;
      inerted.forEach(function (el) { el.removeAttribute('inert'); });
      inerted = [];
      document.body.style.overflow = '';
      input.value = '';
      render();
      // inert를 벗긴 뒤에 돌려줘야 포커스가 들어간다. '/'로 열었으면 직전 포커스가
      // body라 돌려줄 데가 없으니, 그때는 트리거를 짚어 준다.
      var back = lastFocused && lastFocused !== document.body && lastFocused.focus ? lastFocused : trigger;
      back.focus();
    }

    trigger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('mousedown', function (e) {
      if (e.target === overlay) close();
    });
    input.addEventListener('input', render);

    scopeButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        scope = btn.getAttribute('data-scope');
        scopeButtons.forEach(function (other) {
          var on = other === btn;
          other.classList.toggle('active', on);
          other.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        render();
        input.focus();
      });
    });

    panel.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (!hits.length) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); setCursor(cursor + 1, true); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setCursor(cursor - 1, true); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        var row = list.querySelector('.search-hit[aria-selected="true"]');
        if (row) window.location.href = row.href;
      }
    });

    document.addEventListener('keydown', function (e) {
      var t = e.target;
      var tag = t && t.tagName ? String(t.tagName).toUpperCase() : '';
      var typing = !!(t && (t.isContentEditable || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT'));

      if (e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey && !typing) {
        e.preventDefault();
        open();
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
      }
    });
  })();

  (function () {
    var toggle = document.getElementById('navMenuToggle');
    var nav = document.getElementById('mobileNav');
    if (!toggle || !nav) return;

    toggle.addEventListener('click', function () {
      var willOpen = nav.hidden;
      nav.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      toggle.setAttribute('aria-label', willOpen ? '메뉴 닫기' : '메뉴 열기');
      toggle.classList.toggle('is-open', willOpen);
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    padding: 18px 0;
    background: var(--header-bg);
    backdrop-filter: blur(16px);
    transition: background 0.4s, border-color 0.4s;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text);
    height: 28px;
    flex-shrink: 0;
  }
  .logo-symbol {
    height: 28px;
    width: auto;
  }
  .logo-text {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent-bright);
    line-height: 1;
  }

  .logo-light { display: block; }
  .logo-dark { display: none; }
  :global([data-theme="dark"]) .logo-light { display: none; }
  :global([data-theme="dark"]) .logo-dark { display: block; }

  .logo-divider {
    color: var(--border);
    font-weight: 300;
    font-size: 18px;
  }
  .logo-suffix {
    font-size: 13px;
    color: var(--text-dim);
    letter-spacing: 0.08em;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .main-nav {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }
  .main-nav a {
    display: inline-flex;
    align-items: center;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    transition: color 0.25s;
    position: relative;
    white-space: nowrap;
  }
  .main-nav a:hover { color: var(--accent-bright); }
  .main-nav a.active { color: var(--accent-bright); }
  /* 지금 보고 있는 메뉴 — 목차의 활성 막대와 같은 포인트 컬러로 짚는다 */
  .main-nav a.active::after {
    content: '';
    position: absolute;
    bottom: -6px; left: 0; right: 0;
    height: 1px;
    background: var(--brand);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* 검색 트리거 — 입력창처럼 생긴 알약 */
  .nav-search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: min(206px, 42vw);
    min-width: 164px;
    height: 32px;
    padding-inline: 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease;
  }
  .nav-search-trigger:hover {
    border-color: var(--text-dim);
    background: var(--bg-subtle);
  }
  .nav-search-trigger svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--text-dim);
    stroke: currentColor;
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 테마 토글과 같은 34px 원 */
  .menu-toggle {
    display: none;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: none;
    color: var(--text-dim);
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease;
  }
  .menu-toggle:hover {
    background: var(--bg-subtle);
    color: var(--accent-bright);
  }
  .menu-toggle svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.7;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .menu-toggle .icon-close { display: none; }
  .menu-toggle.is-open .icon-menu { display: none; }
  .menu-toggle.is-open .icon-close { display: block; }

  .mobile-nav {
    border-top: 1px solid var(--border);
    background: var(--bg);
    padding: 10px 0 16px;
    margin-top: 18px;
    margin-bottom: -18px;
  }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
  }
  .mobile-nav-link {
    position: relative;
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    color: var(--text-dim);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .mobile-nav-link.active { color: var(--accent-bright); }
  .mobile-nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -1px; left: 0;
    width: 28px;
    height: 1px;
    background: var(--brand);
  }

  /* ── 검색 오버레이 ────────────────────────────────── */
  .search-backdrop {
    position: fixed;
    inset: 0;
    /* 50=헤더, 1000=이미지 라이트박스. 그 사이에 둔다. */
    z-index: 120;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 20px 20px;
    background: rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(7px);
    animation: searchFade 140ms ease-out;
  }
  .search-backdrop[hidden] { display: none; }

  .search-panel {
    display: flex;
    flex-direction: column;
    width: min(100%, 620px);
    max-height: 74vh;
    border: 1px solid var(--border);
